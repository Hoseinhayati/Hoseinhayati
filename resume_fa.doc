<style>
body{font-family:'Segoe UI',Tahoma,sans-serif;color:#222;line-height:1.55;margin:30px 40px;font-size:10.5pt;direction:rtl}
h1{font-size:18pt;color:#1e3a5f;margin:0 0 2px}
