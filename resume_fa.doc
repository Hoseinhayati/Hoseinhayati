.jh{margin:0;font-size:10.5pt;color:#1e3a5f;font-weight:bold}
.jp{font-size:9pt;color:#64748b;margin:0 0 2px}
.jl{font-size:8.5pt;color:#94a3b8;font-style:italic;margin:0 0 4px}
.pt{font-size:9.5pt;color:#2563eb;font-weight:bold;margin:8px 0 2px}
ul{margin:2px 0 6px;padding-right:18px;padding-left:0}
li{font-size:9.5pt;padding:1px 0}
.proj-title{font-size:10pt;color:#1e3a5f;font-weight:bold;margin:0 0 2px}
.proj-desc{font-size:8.5pt;color:#64748b;font-style:italic;margin:0 0 3px}
.soft-cols{column-count:2;column-gap:20px}
.soft-cols li{font-size:9.5pt;break-inside:avoid}
.edu-title{font-size:10pt;color:#1e3a5f;font-weight:bold;margin:0}
.edu-info{font-size:9pt;color:#64748b;margin:0}
.links a{color:#2563eb;font-size:9.5pt;text-decoration:none;margin-left:16px}
</style></head>
